config ENTROPY_AST27XX_RNG
	bool "ASPEED AST27XX RNG entropy driver"
	default y
	depends on DT_HAS_ASPEED_AST2700_RNG_ENABLED
	select ENTROPY_HAS_DRIVER
	select SYSCON
	help
	  Enable the SCU1 random number generator driver for ASPEED AST2700.
