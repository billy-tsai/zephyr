config PINCTRL_ASPEED_G7
	bool "ASPEED G7 pin controller driver"
	default y
	depends on DT_HAS_ASPEED_AST2700_SOC1_PINCTRL_ENABLED
	select SYSCON
	help
	  Enable the pin controller driver for ASPEED G7 SoCs, which programs
	  the SCU fields that the devicetree pin nodes describe.

config PINCTRL_ASPEED_G7_CONFLICT_CHECK
	bool "Reject conflicting functions on a ball"
	depends on PINCTRL_ASPEED_G7
	help
	  Track the function selected on each ball and reject a pin state that
	  selects a different function on a ball already in use. The table
	  takes 4 bytes of RAM per ball.
