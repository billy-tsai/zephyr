		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 6, 2)>;
	};

	/omit-if-no-ref/ pin_di2c0sda: di2c0sda {
		aspeed,ball = <AST27XX_SOC1_BALL_D9>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 12, 4)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 3, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 6, 2)>;
	};

	/omit-if-no-ref/ pin_vpi_3: vpi-3 {
		aspeed,ball = <AST27XX_SOC1_BALL_D9>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 12, 5)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 3, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 6, 2)>;
	};

	/omit-if-no-ref/ pin_espi1_4: espi1-4 {
		aspeed,ball = <AST27XX_SOC1_BALL_F14>;
