#include <zephyr/dt-bindings/pinctrl/ast27xx-soc1-pinctrl.h>

&pinctrl {
	/* SCU1 0x3B0: USB Controller Register (PORTC/PORTD mode) */
	/omit-if-no-ref/ pin_usb2cud: usb2cud {
		aspeed,ball = <AST27XX_SOC1_BALL_PORTC_MODE>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x3b0, 0, 0)>;
	};

	/omit-if-no-ref/ pin_usb2cd: usb2cd {
		aspeed,ball = <AST27XX_SOC1_BALL_PORTC_MODE>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x3b0, 0, 1)>;
	};

	/omit-if-no-ref/ pin_usb2ch: usb2ch {
		aspeed,ball = <AST27XX_SOC1_BALL_PORTC_MODE>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x3b0, 0, 2)>;
	};

	/omit-if-no-ref/ pin_usb2cu: usb2cu {
		aspeed,ball = <AST27XX_SOC1_BALL_PORTC_MODE>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x3b0, 0, 3)>;
	};

	/omit-if-no-ref/ pin_usb2dd: usb2dd {
		aspeed,ball = <AST27XX_SOC1_BALL_PORTD_MODE>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x3b0, 2, 1)>;
	};

	/omit-if-no-ref/ pin_usb2dh: usb2dh {
		aspeed,ball = <AST27XX_SOC1_BALL_PORTD_MODE>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x3b0, 2, 2)>;
	};

	/* SCU1 0x400: Multi-function Pin Control #1 */
	/omit-if-no-ref/ pin_espi1_0: espi1-0 {
		aspeed,ball = <AST27XX_SOC1_BALL_C16>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 0, 1)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 0, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 0, 2)>;
	};

	/omit-if-no-ref/ pin_lpc1_0: lpc1-0 {
		aspeed,ball = <AST27XX_SOC1_BALL_C16>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 0, 2)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 0, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 0, 2)>;
	};

	/omit-if-no-ref/ pin_sd_0: sd-0 {
		aspeed,ball = <AST27XX_SOC1_BALL_C16>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 0, 3)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 0, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 0, 2)>;
	};

	/omit-if-no-ref/ pin_di2c0scl: di2c0scl {
		aspeed,ball = <AST27XX_SOC1_BALL_C16>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 0, 4)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 0, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 0, 2)>;
	};

	/omit-if-no-ref/ pin_vpi_0: vpi-0 {
		aspeed,ball = <AST27XX_SOC1_BALL_C16>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 0, 5)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 0, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 0, 2)>;
	};

	/omit-if-no-ref/ pin_espi1_1: espi1-1 {
		aspeed,ball = <AST27XX_SOC1_BALL_C14>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 4, 1)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 1, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 2, 2)>;
	};

	/omit-if-no-ref/ pin_lpc1_1: lpc1-1 {
		aspeed,ball = <AST27XX_SOC1_BALL_C14>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 4, 2)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 1, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 2, 2)>;
	};

	/omit-if-no-ref/ pin_sd_1: sd-1 {
		aspeed,ball = <AST27XX_SOC1_BALL_C14>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 4, 3)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 1, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 2, 2)>;
	};

	/omit-if-no-ref/ pin_di2c1scl: di2c1scl {
		aspeed,ball = <AST27XX_SOC1_BALL_C14>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 4, 4)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 1, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 2, 2)>;
	};

	/omit-if-no-ref/ pin_vpi_1: vpi-1 {
		aspeed,ball = <AST27XX_SOC1_BALL_C14>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 4, 5)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 1, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 2, 2)>;
	};

	/omit-if-no-ref/ pin_espi1_2: espi1-2 {
		aspeed,ball = <AST27XX_SOC1_BALL_C11>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 8, 1)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 2, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 4, 2)>;
	};

	/omit-if-no-ref/ pin_lpc1_2: lpc1-2 {
		aspeed,ball = <AST27XX_SOC1_BALL_C11>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 8, 2)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 2, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 4, 2)>;
	};

	/omit-if-no-ref/ pin_sd_2: sd-2 {
		aspeed,ball = <AST27XX_SOC1_BALL_C11>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 8, 3)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 2, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 4, 2)>;
	};

	/omit-if-no-ref/ pin_di2c3scl: di2c3scl {
		aspeed,ball = <AST27XX_SOC1_BALL_C11>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 8, 4)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 2, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 4, 2)>;
	};

	/omit-if-no-ref/ pin_vpi_2: vpi-2 {
		aspeed,ball = <AST27XX_SOC1_BALL_C11>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 8, 5)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 2, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 4, 2)>;
	};

	/omit-if-no-ref/ pin_espi1_3: espi1-3 {
		aspeed,ball = <AST27XX_SOC1_BALL_D9>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 12, 1)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 3, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 6, 2)>;
	};

	/omit-if-no-ref/ pin_lpc1_3: lpc1-3 {
		aspeed,ball = <AST27XX_SOC1_BALL_D9>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 12, 2)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 3, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 6, 2)>;
	};

	/omit-if-no-ref/ pin_sd_3: sd-3 {
		aspeed,ball = <AST27XX_SOC1_BALL_D9>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 12, 3)>;
