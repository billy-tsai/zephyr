		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 4, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 8, 2)>;
	};

	/omit-if-no-ref/ pin_sd_4: sd-4 {
		aspeed,ball = <AST27XX_SOC1_BALL_F14>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 16, 3)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 4, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 8, 2)>;
	};

	/omit-if-no-ref/ pin_di2c1sda: di2c1sda {
		aspeed,ball = <AST27XX_SOC1_BALL_F14>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 16, 4)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 4, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 8, 2)>;
	};

	/omit-if-no-ref/ pin_vpi_4: vpi-4 {
		aspeed,ball = <AST27XX_SOC1_BALL_F14>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 16, 5)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 4, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 8, 2)>;
	};

	/omit-if-no-ref/ pin_espi1_5: espi1-5 {
		aspeed,ball = <AST27XX_SOC1_BALL_D10>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 20, 1)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 5, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 10, 2)>;
	};

	/omit-if-no-ref/ pin_lpc1_5: lpc1-5 {
		aspeed,ball = <AST27XX_SOC1_BALL_D10>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 20, 2)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 5, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 10, 2)>;
	};

	/omit-if-no-ref/ pin_sd_5: sd-5 {
		aspeed,ball = <AST27XX_SOC1_BALL_D10>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 20, 3)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 5, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 10, 2)>;
	};

	/omit-if-no-ref/ pin_di2c2scl: di2c2scl {
		aspeed,ball = <AST27XX_SOC1_BALL_D10>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 20, 4)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 5, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 10, 2)>;
	};

	/omit-if-no-ref/ pin_vpi_5: vpi-5 {
		aspeed,ball = <AST27XX_SOC1_BALL_D10>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 20, 5)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 5, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 10, 2)>;
	};

	/omit-if-no-ref/ pin_espi1_6: espi1-6 {
		aspeed,ball = <AST27XX_SOC1_BALL_C12>;
		aspeed,mux = <ASPEED_G7_PINMUX(0x400, 24, 1)>;
		aspeed,bias-disable-field = <ASPEED_G7_PINCFG(0x480, 6, 1)>;
		aspeed,drive-strength-field = <ASPEED_G7_PINCFG(0x4c0, 12, 2)>;
	};

	/omit-if-no-ref/ pin_lpc1_6: lpc1-6 {
		aspeed,ball = <AST27XX_SOC1_BALL_C12>;
