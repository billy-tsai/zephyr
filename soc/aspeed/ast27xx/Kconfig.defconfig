if SOC_AST2700_BOOTMCU

configdefault NUM_IRQS
	default 16

configdefault CLOCK_CONTROL
	default y

# The SCU clock and reset controllers access their registers through the parent
# syscon devices.
configdefault CLOCK_CONTROL_INIT_PRIORITY
	default SYSCON_INIT_PRIORITY

configdefault RESET_INIT_PRIORITY
	default SYSCON_INIT_PRIORITY

endif # SOC_AST2700_BOOTMCU
